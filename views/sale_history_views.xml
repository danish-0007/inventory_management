<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: read-only sales history — create/edit disabled, data comes from wizard -->
    <record id="view_agro_sale_history_list" model="ir.ui.view">
        <field name="name">sale.order.agro.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Sales History" create="false" edit="false">
                <field name="name" string="Receipt No"/>
                <field name="date_order" string="Date"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id" string="Salesperson"/>
                <field name="agro_payment_method" string="Payment"/>
                <field name="amount_total" string="Total"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'sale'"
                    decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <!-- Form view: view a past sale with Print Receipt button -->
    <record id="view_agro_sale_history_form" model="ir.ui.view">
        <field name="name">sale.order.agro.form</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Sale" create="false">
                <header>
                    <!-- Re-print receipt for any past sale -->
                    <button name="%(inventory_management.report_agro_sale_receipt)d"
                        type="action" string="Print Receipt" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Receipt No" readonly="1"/>
                            <field name="date_order" string="Date" readonly="1"/>
                            <field name="partner_id" string="Customer" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" string="Salesperson" readonly="1"/>
                            <field name="agro_payment_method" readonly="1"/>
                            <field name="amount_total" string="Total" readonly="1"/>
                        </group>
                    </group>
                    <!-- Line items: product, batch sold, qty, price, discount, subtotal -->
                    <field name="order_line" readonly="1">
                        <tree>
                            <field name="product_id" string="Product"/>
                            <field name="agro_lot_id" string="Batch"/>
                            <field name="product_uom_qty" string="Qty"/>
                            <field name="price_unit" string="Price"/>
                            <field name="discount" string="Disc %"/>
                            <field name="price_subtotal" string="Subtotal"/>
                        </tree>
                    </field>
                    <group>
                        <field name="note" string="Notes" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: filtered to shop sales only — grouped by month for easy reporting -->
    <record id="action_agro_sale_history" model="ir.actions.act_window">
        <field name="name">Sales History</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_agro_sale_history_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_agro_sale_history_form')}),
        ]"/>
        <!-- agro_is_shop_sale=True excludes any standard Odoo orders from this view -->
        <field name="domain">[('agro_is_shop_sale', '=', True)]</field>
        <field name="context">{'search_default_group_by_month': 1}</field>
    </record>

</odoo>
