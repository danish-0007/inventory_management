<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard form: Receive Stock popup — opens as a dialog (target: new) -->
    <record id="view_agro_purchase_wizard_form" model="ir.ui.view">
        <field name="name">agro.purchase.wizard.form</field>
        <field name="model">agro.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Stock">
                <group>
                    <group>
                        <field name="supplier_id"/>
                        <field name="date"/>
                    </group>
                </group>
                <!-- Inline editable table — operator adds received items here -->
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="batch_name"/>  <!-- auto-generated, can be overridden -->
                        <field name="quantity"/>
                        <field name="unit_price" string="Cost Price"/>
                        <field name="expiry_date"/>
                        <field name="subtotal" readonly="1"/>
                    </tree>
                </field>
                <!-- Total cost of this receipt -->
                <group class="oe_subtotal_footer">
                    <field name="total_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                </group>
                <group>
                    <field name="notes" placeholder="Notes..."/>
                </group>
                <footer>
                    <!-- Confirm creates purchase.order, validates receipt, updates stock -->
                    <button name="action_receive" type="object" string="Receive Stock"
                        class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: opens the purchase wizard as a popup — triggered by Receive Stock menu -->
    <record id="action_agro_new_purchase" model="ir.actions.act_window">
        <field name="name">Receive Stock</field>
        <field name="res_model">agro.purchase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
