<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: all batches with color-coding (red=expired, orange=expiring soon) -->
    <record id="view_agro_lot_list" model="ir.ui.view">
        <field name="name">stock.lot.agro.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Batches"
                decoration-danger="expiry_status == 'expired'"
                decoration-warning="expiry_status == 'expiring'">
                <field name="name" string="Batch No"/>
                <field name="product_id" string="Product"/>
                <field name="product_qty" string="On Hand"/>
                <field name="purchase_date"/>
                <field name="expiration_date" string="Expiry Date"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="expiry_status" widget="badge"
                    decoration-success="expiry_status == 'ok'"
                    decoration-warning="expiry_status == 'expiring'"
                    decoration-danger="expiry_status == 'expired'"/>
                <field name="unit_price" string="Cost Price"/>
            </list>
        </field>
    </record>

    <!-- Form view: full batch detail — dates, cost, expiry status -->
    <record id="view_agro_lot_form" model="ir.ui.view">
        <field name="name">stock.lot.agro.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Batch">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name" string="Batch No"/>
                            <!-- Shows whether batch name was auto-generated or manually typed -->
                            <field name="auto_batch_sequence" readonly="1"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Stock">
                            <field name="product_qty" string="On Hand" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="purchase_date"/>
                            <field name="expiration_date" string="Expiry Date"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="expiry_status" widget="badge"
                                decoration-success="expiry_status == 'ok'"
                                decoration-warning="expiry_status == 'expiring'"
                                decoration-danger="expiry_status == 'expired'"/>
                        </group>
                        <group string="Cost">
                            <field name="unit_price" string="Cost Price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: opens all batches — referenced by Batches > All Batches menu -->
    <record id="action_agro_batches" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_agro_lot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_agro_lot_form')}),
        ]"/>
    </record>

    <!-- Action: same view but pre-filtered to expiring/expired batches with remaining stock -->
    <record id="action_agro_expiring_batches" model="ir.actions.act_window">
        <field name="name">Expiring Soon</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_agro_lot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_agro_lot_form')}),
        ]"/>
        <field name="domain">[('expiry_status', 'in', ['expiring', 'expired']), ('product_qty', '>', 0)]</field>
    </record>

</odoo>
