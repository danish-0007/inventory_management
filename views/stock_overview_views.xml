<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: morning glance — all products with stock levels, color-coded by status -->
    <record id="view_agro_stock_overview_list" model="ir.ui.view">
        <field name="name">product.template.stock.overview.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Stock Overview"
                decoration-danger="stock_status == 'out'"
                decoration-warning="stock_status == 'low'"
                create="false" edit="false">
                <field name="name" string="Product"/>
                <field name="agro_category_id" string="Category"/>
                <field name="uom_id" string="Unit"/>
                <field name="qty_available" string="On Hand"/>
                <field name="min_stock" string="Min Stock"/>
                <field name="stock_status" widget="badge"
                    decoration-success="stock_status == 'ok'"
                    decoration-warning="stock_status == 'low'"
                    decoration-danger="stock_status == 'out'"/>
            </list>
        </field>
    </record>

    <!-- Action: full stock overview grouped by category -->
    <record id="action_agro_stock_overview" model="ir.actions.act_window">
        <field name="name">Stock Overview</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_agro_stock_overview_list')}),
        ]"/>
        <field name="context">{'search_default_group_by_category': 1}</field>
    </record>

    <!-- Action: same view pre-filtered to low/out-of-stock products only -->
    <record id="action_agro_low_stock" model="ir.actions.act_window">
        <field name="name">Low Stock</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_agro_stock_overview_list')}),
        ]"/>
        <field name="domain">[('stock_status', 'in', ['low', 'out'])]</field>
    </record>

</odoo>
