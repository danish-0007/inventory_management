<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agro_village_list" model="ir.ui.view">
        <field name="name">agro.village.list</field>
        <field name="model">agro.village</field>
        <field name="arch" type="xml">
            <tree string="Villages" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_agro_village" model="ir.actions.act_window">
        <field name="name">Villages</field>
        <field name="res_model">agro.village</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
