<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agro_crop_list" model="ir.ui.view">
        <field name="name">agro.crop.list</field>
        <field name="model">agro.crop</field>
        <field name="arch" type="xml">
            <tree string="Crops" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_agro_crop" model="ir.actions.act_window">
        <field name="name">Crops</field>
        <field name="res_model">agro.crop</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
