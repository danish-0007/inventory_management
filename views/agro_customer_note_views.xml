<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Full, editable history — opened via the "View All Notes" button on the customer form -->
    <record id="view_agro_customer_note_list" model="ir.ui.view">
        <field name="name">agro.customer.note.list</field>
        <field name="model">agro.customer.note</field>
        <field name="arch" type="xml">
            <tree string="Notes &amp; Field History" editable="top">
                <field name="note_date" readonly="1"/>
                <field name="user_id" readonly="1"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_agro_customer_note_form" model="ir.ui.view">
        <field name="name">agro.customer.note.form</field>
        <field name="model">agro.customer.note</field>
        <field name="arch" type="xml">
            <form string="Note">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="note_date" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
