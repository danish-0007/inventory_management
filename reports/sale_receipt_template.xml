<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        QWeb receipt template — rendered as PDF when operator clicks Print Receipt.
        Data sources:
          - docs        : the sale.order record(s) being printed
          - config      : inventory.config singleton (shop name, logo, GST, footer)
          - order_line  : sale.order.line records (items sold)
        Layout: shop header top-left, receipt info top-right, items table, totals, footer.
    -->
    <template id="report_agro_sale_receipt_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Load shop config for header/footer values -->
                <t t-set="config" t-value="env['inventory.config'].search([], limit=1)"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Shop header: logo, name, address, phone, GST -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <t t-if="config and config.shop_logo">
                                    <img t-att-src="'data:image/png;base64,' + config.shop_logo.decode()"
                                         style="max-height:80px;" alt="Logo"/>
                                </t>
                                <h2 t-if="config"><t t-esc="config.shop_name"/></h2>
                                <p t-if="config and config.shop_address" style="white-space:pre-line;">
                                    <t t-esc="config.shop_address"/>
                                </p>
                                <p t-if="config and config.shop_phone">
                                    Tel: <t t-esc="config.shop_phone"/>
                                </p>
                                <p t-if="config and config.gst_number">
                                    GST: <t t-esc="config.gst_number"/>
                                </p>
                            </div>
                            <!-- Receipt meta: number, date, payment method -->
                            <div class="col-6 text-right">
                                <h3>RECEIPT</h3>
                                <p><strong>No:</strong> <t t-esc="o.name"/></p>
                                <p><strong>Date:</strong>
                                    <t t-esc="o.date_order" t-options="{'widget': 'date'}"/>
                                </p>
                                <p><strong>Payment:</strong>
                                    <t t-esc="dict(o._fields['agro_payment_method'].selection).get(o.agro_payment_method, '')"/>
                                </p>
                                <!-- Credit sales must show the customer when payment is due -->
                                <t t-if="o.agro_payment_method == 'credit'">
                                    <p style="color:#b00;">
                                        <strong>Amount Due:</strong>
                                        <t t-esc="o.agro_amount_outstanding" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        <strong>&amp;nbsp;&amp;nbsp;by</strong>
                                        <t t-esc="o.agro_due_date" t-options="{'widget': 'date'}"/>
                                    </p>
                                </t>
                            </div>
                        </div>

                        <!-- Customer and salesperson info -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <strong>Customer: </strong><t t-esc="o.partner_id.name"/>
                                <t t-if="o.user_id">
                                    &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;
                                    <strong>Served by: </strong><t t-esc="o.user_id.name"/>
                                </t>
                            </div>
                        </div>

                        <!-- Items table: product, batch, qty, price, discount, subtotal -->
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Batch</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Disc%</th>
                                    <th class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line" t-as="line">
                                    <tr>
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="line.product_id.name"/></td>
                                        <td><t t-esc="line.agro_lot_id.name or ''"/></td>
                                        <td class="text-right">
                                            <t t-if="line.agro_sold_uom_id">
                                                <t t-esc="'%g' % line.agro_sold_qty"/> <t t-esc="line.agro_sold_uom_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="'%g' % line.product_uom_qty"/> <t t-esc="line.product_uom.name"/>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> / <t t-esc="line.product_uom.name"/>
                                        </td>
                                        <td class="text-right">
                                            <!-- Only show discount cell if a discount was applied -->
                                            <t t-if="line.discount"><t t-esc="line.discount"/>%</t>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals: show subtotal + tax breakdown when tax was applied -->
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <t t-if="o.amount_tax">
                                        <tr>
                                            <td>Subtotal</td>
                                            <td class="text-right">
                                                <t t-esc="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Tax</td>
                                            <td class="text-right">
                                                <t t-esc="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-right">
                                            <strong>
                                                <t t-esc="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Order notes if any -->
                        <t t-if="o.note">
                            <p><em><t t-esc="o.note"/></em></p>
                        </t>

                        <!-- Footer message from shop config (e.g. "Thank you for your purchase!") -->
                        <div class="text-center mt-4">
                            <t t-if="config and config.receipt_footer">
                                <p><t t-esc="config.receipt_footer"/></p>
                            </t>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
