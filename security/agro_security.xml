<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cashier: day-to-day selling/receiving. Manager: also allowed to change shop settings. -->
    <record id="group_agro_cashier" model="res.groups">
        <field name="name">Agro Shop / Cashier</field>
    </record>

    <record id="group_agro_manager" model="res.groups">
        <field name="name">Agro Shop / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_agro_cashier'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
