<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default Units -->
        <record id="unit_kg" model="inventory.unit">
            <field name="name">Kilogram</field>
            <field name="symbol">kg</field>
            <field name="category">weight</field>
        </record>
        <record id="unit_gram" model="inventory.unit">
            <field name="name">Gram</field>
            <field name="symbol">g</field>
            <field name="category">weight</field>
        </record>
        <record id="unit_litre" model="inventory.unit">
            <field name="name">Litre</field>
            <field name="symbol">L</field>
            <field name="category">volume</field>
        </record>
        <record id="unit_ml" model="inventory.unit">
            <field name="name">Millilitre</field>
            <field name="symbol">ml</field>
            <field name="category">volume</field>
        </record>
        <record id="unit_qty" model="inventory.unit">
            <field name="name">Quantity</field>
            <field name="symbol">qty</field>
            <field name="category">count</field>
        </record>
        <record id="unit_pack" model="inventory.unit">
            <field name="name">Pack</field>
            <field name="symbol">pack</field>
            <field name="category">count</field>
        </record>
        <record id="unit_bag" model="inventory.unit">
            <field name="name">Bag</field>
            <field name="symbol">bag</field>
            <field name="category">count</field>
        </record>
        <record id="unit_bundle" model="inventory.unit">
            <field name="name">Bundle</field>
            <field name="symbol">bundle</field>
            <field name="category">count</field>
        </record>

        <!-- Default Categories -->
        <record id="category_seeds" model="inventory.category">
            <field name="name">Seeds</field>
        </record>
        <record id="category_fertilizers" model="inventory.category">
            <field name="name">Fertilizers</field>
        </record>
        <record id="category_pesticides" model="inventory.category">
            <field name="name">Pesticides</field>
        </record>
        <record id="category_feed" model="inventory.category">
            <field name="name">Animal Feed</field>
        </record>
        <record id="category_tools" model="inventory.category">
            <field name="name">Tools</field>
        </record>

        <!-- Walk-in Customer -->
        <record id="partner_walkin_customer" model="res.partner">
            <field name="name">Walk-in Customer</field>
            <field name="customer_rank">1</field>
        </record>

        <!-- Default Shop Config (singleton) -->
        <record id="agro_shop_config" model="inventory.config">
            <field name="shop_name">Agro &amp; Seeds Shop</field>
            <field name="expiry_warning_days">30</field>
            <field name="default_walkin_partner_id" ref="partner_walkin_customer"/>
            <field name="receipt_footer">Thank you for your purchase!</field>
        </record>

    </data>
</odoo>
