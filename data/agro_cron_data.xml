<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Re-flags overdue bills daily — "today" passing doesn't trigger Odoo's own dependency tracking -->
    <record id="ir_cron_agro_update_overdue" model="ir.cron">
        <field name="name">Agro: Update Overdue Bill Status</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_overdue_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall"/>
        <field eval="True" name="active"/>
    </record>

</odoo>
