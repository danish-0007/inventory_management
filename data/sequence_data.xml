<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_agro_batch" model="ir.sequence">
            <field name="name">Agro Batch Number</field>
            <field name="code">agro.batch</field>
            <field name="prefix">BATCH/%(year)s%(month)s%(day)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
